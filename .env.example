PORT=3000
# NODE_ENV=production lo define el Dockerfile; en desarrollo local déjalo vacío.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/defaultdb?sslmode=require

# Certificado CA de la base (DigitalOcean → Database → Connection details → Download CA).
# Con él se verifica el servidor PostgreSQL. Pega el PEM completo (los \n se aceptan) o usa una ruta.
DATABASE_CA_CERT=
# DATABASE_CA_CERT_PATH=/etc/below/ca-certificate.crt
# DATABASE_POOL_MAX=10

# Proxies delante de la app (DigitalOcean App Platform = 1). Necesario para HTTPS y el límite de intentos.
TRUST_PROXY=1
# Otros dominios propios que pueden enviar formularios a la API (separados por coma). Normalmente vacío.
ALLOWED_ORIGINS=

# SUNAT - Consulta integrada de validez CPE
# Estas credenciales se generan en SUNAT Operaciones en Línea (SOL).
SUNAT_CLIENT_ID=
SUNAT_CLIENT_SECRET=
# RUC de la empresa que realiza la consulta a SUNAT.
SUNAT_QUERY_RUC=
# SUNAT_TIMEOUT_MS=15000

# DigitalOcean Spaces (opcional; si no se configura, los archivos se guardan localmente)
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
SPACES_REGION=sfo3
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=

# Lector de comprobantes
# RUC de las empresas Below que aparecen como CLIENTE en las facturas (separados por coma).
# El lector nunca los propone como emisor. SUNAT_QUERY_RUC se excluye siempre.
COMPANY_RUCS=
# Lectores OCR en paralelo (cada uno usa ~150 MB de RAM). Usa 2 con 1 GB de RAM o más.
# OCR_WORKERS=1
# OCR_TIMEOUT_MS=45000
# El modelo OCR en español viene incluido. Solo cambiar para usar otra carpeta.
# TESSERACT_LANG_PATH=
